<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="525.0" prefWidth="784.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.project.booksphere.controller.ForgotPasswordController">
   <children>
      <Label layoutX="259.0" layoutY="14.0" prefHeight="46.0" prefWidth="266.0" text="RESET PASSWORD">
         <font>
            <Font name="System Bold" size="30.0" />
         </font>
         <textFill>
            <LinearGradient endX="0.9583333188837224" endY="0.3106060407378456" startX="0.9545454540939042" startY="0.8333333604263538">
               <stops>
                  <Stop>
                     <color>
                        <Color green="0.29019609093666077" blue="0.6784313917160034" />
                     </color>
                  </Stop>
                  <Stop offset="1.0">
                     <color>
                        <Color red="0.364705890417099" green="0.8784313797950745" blue="0.9019607901573181" />
                     </color>
                  </Stop>
               </stops>
            </LinearGradient>
         </textFill>
      </Label>
      <Group layoutX="117.0" layoutY="76.0">
         <children>
            <Label layoutY="2.0" prefHeight="26.0" prefWidth="169.0" text="Enter your Email Address :">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <TextField fx:id="txtEmail" layoutX="182.0" prefHeight="30.0" prefWidth="268.0" style="-fx-background-color: transparent; -fx-border-color: #00a8ff; -fx-border-width: 0px 0px 2px;" />
         </children>
      </Group>
      <TextField fx:id="txtOTP" layoutX="299.0" layoutY="137.0" prefHeight="30.0" prefWidth="268.0" style="-fx-background-color: transparent; -fx-border-color: #00a8ff; -fx-border-width: 0px 0px 2px;" />
      <Label fx:id="lblOTP" layoutX="117.0" layoutY="142.0" prefHeight="26.0" prefWidth="169.0" text="OPT">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <Button fx:id="btnSendOPT" layoutX="579.0" layoutY="77.0" mnemonicParsing="false" onAction="#sendGmail" prefHeight="26.0" prefWidth="121.0" style="-fx-background-color: #00a8ff; -fx-border-color: #00a8ff;" text="Send OPT">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
      <Button fx:id="btnSubmit" layoutX="579.0" layoutY="141.0" mnemonicParsing="false" onAction="#submitOtp" prefHeight="26.0" prefWidth="121.0" style="-fx-background-color: #00a8ff; -fx-border-color: #00a8ff;" text="Submit">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
      <Group layoutX="173.0" layoutY="276.0">
         <children>
            <PasswordField fx:id="txtNewPassword" layoutX="170.0" prefHeight="31.0" prefWidth="268.0" promptText="New Password" style="-fx-background-color: transparent; -fx-border-color: #74b9ff; -fx-border-width: 0px 0px 2px;" />
            <PasswordField fx:id="txtConfirmPassword" layoutX="170.0" layoutY="50.0" prefHeight="31.0" prefWidth="268.0" promptText="Confirm Password" style="-fx-background-color: transparent; -fx-border-color: #74b9ff; -fx-border-width: 0px 0px 2px;" />
            <Label fx:id="lblNewPassword" layoutY="3.0" prefHeight="26.0" prefWidth="169.0" text="New Password">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <Label fx:id="lblConfirmPassword" layoutY="53.0" prefHeight="26.0" prefWidth="169.0" text="Confirm Password">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <Button fx:id="btnReset" layoutX="316.0" layoutY="116.0" mnemonicParsing="false" onAction="#resetPassword" prefHeight="26.0" prefWidth="121.0" style="-fx-background-color: #00a8ff; -fx-border-color: #00a8ff;" text="Reset Password">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
         </children>
      </Group>
   </children>
</AnchorPane>
