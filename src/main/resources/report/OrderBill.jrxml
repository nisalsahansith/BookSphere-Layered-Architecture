<jasperReport name="Bill" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="f0788d1e-0cf7-4691-a102-e6f0b90432ea">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="BookSphere"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="615"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="371"/>
	<parameter name="OrderId" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT DISTINCT
    o.*,od.*,i.*,id.sell_price,
    (id.sell_price * od.OrderQty) AS total,
    pd.*
FROM
    orders o
        LEFT JOIN
    orderdetails od ON o.OrderID = od.OrderID
        LEFT JOIN
    item i ON od.ItemId = i.ItemID
        LEFT JOIN
    item_details id ON i.ItemID = id.ItemID
        LEFT JOIN
    promotion_details pd ON o.OrderID = pd.OrderID LEFT JOIN
    promotion pr ON pd.PromotionID = pr.PromotionID
where o.OrderId =   $P{OrderId} ]]></query>
